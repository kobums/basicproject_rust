# cp .env.example .env 후 값을 바꾼다. .env 는 커밋하지 않는다 (.gitignore).
# 이름은 gomachine bootstrap/.env.example / basicproject_go 와 같다. 앱(cargo run)은 시작할 때 .env 를 읽고,
# 이미 설정된 환경변수가 우선이다. make 와 docker compose 도 이 파일을 읽는다.

# docker-compose (db 서비스)
MARIADB_DATABASE=project
MARIADB_USER=project
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root
DB_PORT=3306

# 앱 + gomachine (gomachine 은 DB_HOST / DB_USER / DB_PASSWORD 를 model.json 보다 우선해서 쓴다)
DB_HOST=127.0.0.1
DB_USER=project
DB_PASSWORD=change-me
# 비어 있으면 MARIADB_DATABASE 를 쓴다. gomachine 은 model.json 의 database 를 쓰므로 같은 이름으로 둔다.
DB_NAME=project
# DB_* 대신 URL 을 직접 줄 수도 있다 (있으면 DB_* 보다 우선. 비밀번호의 특수문자는 직접 percent-encoding)
# DATABASE_URL=mysql://project:change-me@127.0.0.1:3306/project

# 백엔드(Go / Spring / Rust) 공통 JWT 서명 키 (HS256, 32 바이트 이상. 짧으면 서버가 시작하지 않는다)
# 만들기: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-32chars
# 토큰 유효 시간 (밀리초, 기본 24시간)
JWT_EXPIRATION_MS=86400000

# HTTP (basicproject_go 는 8007, Rust 는 8008)
PORT=8008
# develop | production (production 에서는 CORS_ORIGINS 기본값이 없고, change-me JWT_SECRET 을 거부한다)
APP_MODE=develop
# 허용할 프론트엔드 출처 (쉼표 구분, "*" 는 모두). 비우면 develop 은 localhost:5173,3000,9007
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 업로드 루트 (basicproject_go 와 같다). 파일은 {UPLOAD_PATH}/uploads 에 저장하고 /uploads/{파일명} 으로 서빙한다.
UPLOAD_PATH=webdata

# 로그 (SQL 로그: info,sql=debug)
RUST_LOG=info
